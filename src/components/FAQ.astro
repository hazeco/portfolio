---

<section class="mt-4.5 bg-[#0a0912]/90 border border-white/10 rounded-3xl backdrop-blur-md p-5 sm:p-7" id="faq" aria-label="Frequently asked questions">
  <div class="flex justify-between items-end gap-4 flex-wrap mb-5">
    <div>
      <div class="font-mono-code text-[11px] tracking-widest uppercase text-white/70">
        <span class="i18n-en">FAQ</span>
        <span class="i18n-th">คำถามที่พบบ่อย</span>
      </div>
      <h2 class="font-heading text-2xl sm:text-3xl font-extrabold tracking-tight leading-tight mt-1.5 text-white">
        <span class="i18n-en">Frequently asked<br />questions</span>
        <span class="i18n-th">คำถามที่พบบ่อย</span>
      </h2>
    </div>
    <p class="text-sm text-[#c9c2dc] max-w-[520px] m-0">
      <span class="i18n-en">Quick answers about who I am, what I build, and the work I’ve shipped.</span>
      <span class="i18n-th">คำตอบสรุปเกี่ยวกับตัวผม สแตกเทคโนโลยีที่ใช้ และผลงานที่ส่งมอบจริง</span>
    </p>
  </div>

  <div class="border-t border-dashed border-white/20" id="faqList">
    {faqs.map((faq) => (
      <details name="faq-accordion" class="faq-item group border-b border-dashed border-white/20 transition-colors duration-200 open:bg-white/[0.04]">
        <summary class="faq-q w-full flex justify-between items-center gap-4 py-4 sm:py-4.5 px-1 sm:px-1.5 text-left font-heading text-sm sm:text-base font-bold text-white leading-snug cursor-pointer list-none select-none [&::-webkit-details-marker]:hidden">
          <span>
            <span class="i18n-en">{faq.q_en}</span>
            <span class="i18n-th">{faq.q_th}</span>
          </span>
          <span class="faq-icon flex-none w-7 h-7 sm:w-7.5 sm:h-7.5 rounded-full border border-white/25 flex items-center justify-center group-open:rotate-45 group-open:bg-white group-open:border-white transition-transform duration-300 ease-out" aria-hidden="true">
            <svg class="w-3.5 h-3.5 text-white group-open:text-gray-950 transition-colors duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
              <path d="M8 2.5v11M2.5 8h11" />
            </svg>
          </span>
        </summary>
        <div class="pt-0 pb-4.5 px-1 sm:px-1.5 text-sm sm:text-[14.5px] text-[#c9c2dc] leading-relaxed max-w-[820px]">
          <p class="i18n-en m-0" set:html={faq.a_en} />
          <p class="i18n-th m-0" set:html={faq.a_th} />
        </div>
      </details>
    ))}
  </div>
</section>
