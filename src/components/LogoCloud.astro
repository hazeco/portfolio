// ─── Icon sources ────────────────────────────────────────────────────────────
// icon: 'key'   → skillicons.dev   https://skillicons.dev
// slug: 'slug'  → devicons.io CDN  https://devicons.io/icons/{slug}/
//
// เพิ่ม icon:
//   skillicons → { name: 'Bun',   icon: 'bun' }
//   devicons   → { name: 'Nginx', slug: 'nginx' } // พื้นหลังดีฟอลต์ #242938
//   devicons   → { name: 'Git',   slug: 'git', bg: '#f14e32' } // กำหนดสีพื้นหลังเองได้ (hex, rgb, หรือชื่อสี)
// ────────────────────────────────────────────────────────────────────────────

type Skill =
  | { name: string; icon: string; slug?: never; bg?: never }
  | { name: string; slug: string; bg?: string; icon?: never };

function src(s: Skill) {
  return s.icon
    ? `https://skillicons.dev/icons?i=${s.icon}`
    : `https://devicons.io/devicons/icons/${s.slug}.svg`;
}

