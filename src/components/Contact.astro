        <a href="mailto:khetsophonainautoon@gmail.com" class="no-underline text-white hover:text-[#ffb347] transition-colors">
          <span class="i18n-en">Email</span>
          <span class="i18n-th">อีเมล</span>
        </a>
        <div class="flex items-center justify-between sm:justify-end gap-2 w-full sm:w-auto">
          <span class="text-[#c9c2dc] font-mono-code text-[11px] sm:text-xs font-normal break-all">khetsophonainautoon@gmail.com</span>
