            <span class="text-[10px] sm:text-xs text-[#c9c2dc] bg-white/10 px-2 py-0.5 rounded-full group-open:hidden">
              <span class="i18n-en">View QR</span>
              <span class="i18n-th">ดู QR Code</span>
            </span>
            <span class="text-[10px] sm:text-xs text-[#c9c2dc] bg-white/10 px-2 py-0.5 rounded-full hidden group-open:inline-block">
              <span class="i18n-en">Close</span>
              <span class="i18n-th">ปิด</span>
            </span>
          </div>
        </summary>
        <div class="px-3.5 pb-4 pt-1 flex flex-col items-center gap-2 border-t border-white/10 mt-1">
          <div class="bg-white p-2 rounded-xl shadow-lg mt-2 inline-block">
            <img src="/line-qr.png" alt="LINE QR Code (.01010.)" width="160" height="160" class="w-36 h-36 sm:w-40 sm:h-40 block rounded-lg object-contain" loading="lazy" />
          </div>
          <span class="text-xs text-[#c9c2dc] font-mono-code mt-1">LINE ID: <strong class="text-white">.01010.</strong></span>
          <a
            href="/line-qr.png"
