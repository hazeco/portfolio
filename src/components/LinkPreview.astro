---
---
<div class="link-preview fixed z-50 w-[300px] max-w-[calc(100vw-24px)] bg-[#080610]/95 border border-white/20 rounded-2xl overflow-hidden shadow-2xl opacity-0 translate-y-1.5 scale-[0.98] pointer-events-none transition-all duration-200" id="linkPreview" role="tooltip" aria-hidden="true">
  <div class="h-[150px] bg-gradient-to-br from-[#ffb347] via-[#e9407a] to-[#5227ff] grid place-items-center relative overflow-hidden">
    <span class="font-heading font-extrabold text-2xl text-white text-center px-4 leading-snug drop-shadow-md" id="lpFallback">hazeco</span>
    <img id="lpImg" alt="" class="absolute inset-0 w-full h-full object-cover object-top" hidden />
  </div>
  <div class="p-3.5">
    <div class="font-mono-code text-[11px] text-[#ffb347] tracking-wider" id="lpHost"></div>
    <div class="font-heading text-sm font-bold text-white mt-1 leading-snug" id="lpTitle"></div>
    <p class="text-xs text-[#c9c2dc] mt-1 leading-relaxed line-clamp-3" id="lpDesc"></p>
    <div class="text-[11px] text-[#9a92b3] mt-1.5" id="lpNote" hidden>Live preview unavailable — showing link details instead.</div>
  </div>
</div>

<style>
  :global(.link-preview.show) {
    opacity: 1 !important;
    transform: translateY(0) scale(1) !important;
  }
</style>

<script>
  type CacheEntry = {
    status: 'loading' | 'ok' | 'fail';
    src: string;
    callbacks: Array<(ok: boolean) => void>;
  };

  const LOCAL_PREVIEW_BY_URL: Record<string, string> = {
    'https://a-mph.com': '/previews/amph.webp',
    'https://easychecks.easycheck.workers.dev': '/previews/easycheck.webp',
    'https://keystay-web.khetsophon-ain.workers.dev': '/previews/keystay.webp',
    'https://musicgear-web.thunderwolf2209.workers.dev': '/previews/musicgear.webp',
    'https://fly-calcium-band.fly-calcium-band.workers.dev': '/previews/fly-calcium-band.webp',
    'https://github.com/hazeco': '/previews/gh-hazeco.webp',
    'https://github.com/EasyChecks/easychecks': '/previews/gh-easychecks.webp',
    'https://github.com/csi204/keystay': '/previews/gh-keystay.webp',
    'https://github.com/hazeco/CSI402': '/previews/gh-csi402.webp',
    'https://github.com/csi204/musicgear': '/previews/gh-musicgear.webp',
    'https://github.com/hazeco/fly-calcium-band': '/previews/gh-fly-calcium-band.webp',
    'https://github.com/Scramble-Quest/Scramble_Quest': '/previews/gh-scramble-quest.webp',
    'https://github.com/just-chills/chilltopup': '/previews/gh-chilltopup.webp',
    'https://github.com/just-chills/fileHandler': '/previews/gh-filehandler.webp',
  };

  const NO_MSHOT_HOSTS = new Set([
    'facebook.com',
    'web.facebook.com',
    'm.facebook.com',
    'instagram.com',
    'www.instagram.com',
    'linkedin.com',
    'www.linkedin.com',
    'discord.com',
  ]);

  const previewCache = new Map<string, CacheEntry>();
  let prefetched = false;

  function getMshotSrc(a: HTMLAnchorElement): string | null {
    if (a.dataset.previewLock === 'true') return null;
    if (a.pathname.toLowerCase().endsWith('.pdf')) return null;
    if (!a.href.startsWith('http')) return null;
    if (NO_MSHOT_HOSTS.has(a.hostname.toLowerCase())) return null;
    return 'https://s.wordpress.com/mshots/v1/' + encodeURIComponent(a.href) + '?w=600';
  }

  function getPreviewSources(a: HTMLAnchorElement): { localSrc: string | null; mshotSrc: string | null } {
    const normalized = a.href.replace(/\/+$/, '');
    return {
      localSrc: a.dataset.previewImg || LOCAL_PREVIEW_BY_URL[normalized] || null,
      mshotSrc: getMshotSrc(a),
    };
  }

  function loadPreview(src: string, onDone?: (ok: boolean) => void) {
    const existing = previewCache.get(src);
    if (existing) {
      if (existing.status === 'ok') {
        onDone?.(true);
      } else if (existing.status === 'fail') {
        onDone?.(false);
      } else if (onDone) {
        existing.callbacks.push(onDone);
      }
      return;
    }

    const entry: CacheEntry = {
      status: 'loading',
      src,
      callbacks: onDone ? [onDone] : [],
    };
    previewCache.set(src, entry);

    const finish = (ok: boolean) => {
      entry.status = ok ? 'ok' : 'fail';
      const cbs = entry.callbacks.splice(0);
      cbs.forEach((cb) => cb(ok));
    };

    const probe = new Image();
    probe.decoding = 'async';
    probe.onload = () => {
      if (probe.naturalWidth <= 40) {
        finish(false);
        return;
      }
      if (typeof probe.decode === 'function') {
        probe.decode().then(() => finish(true)).catch(() => finish(true));
      } else {
        finish(true);
      }
    };
    probe.onerror = () => finish(false);
    probe.src = src;
  }

  function schedulePrefetch(links: HTMLAnchorElement[]) {
    if (prefetched) return;
    prefetched = true;

    const localSrcs: string[] = [];
    const priorityMshots: string[] = [];
    const otherMshots: string[] = [];
    const seen = new Set<string>();

    for (const a of links) {
      const { localSrc, mshotSrc } = getPreviewSources(a);
      if (localSrc && !seen.has(localSrc)) {
        seen.add(localSrc);
        localSrcs.push(localSrc);
      }
      if (mshotSrc && !seen.has(mshotSrc)) {
        seen.add(mshotSrc);
        if (localSrc) {
          priorityMshots.push(mshotSrc);
        } else {
          otherMshots.push(mshotSrc);
        }
      }
    }

    const queue = [...priorityMshots, ...otherMshots];

    window.setTimeout(() => {
      localSrcs.forEach((src) => loadPreview(src));
      let i = 0;
      const next = () => {
        if (i >= queue.length) return;
        loadPreview(queue[i++]);
        if (i < queue.length) window.setTimeout(next, 80);
      };
      next();
    }, 120);
  }

  function initLinkPreview() {
    const lp = document.getElementById('linkPreview');
    const lpImg = document.getElementById('lpImg') as HTMLImageElement | null;
    const lpFallback = document.getElementById('lpFallback');
    const lpHost = document.getElementById('lpHost');
    const lpTitle = document.getElementById('lpTitle');
    const lpDesc = document.getElementById('lpDesc');
    const lpNote = document.getElementById('lpNote');
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (!lp || !lpImg || !lpFallback || !lpHost || !lpTitle || !lpDesc || !lpNote) return;

    let activeLink: HTMLAnchorElement | null = null;

    function describeLink(a: HTMLAnchorElement) {
      const card = a.closest('article, .contact, .skills, footer, div');
      let title = (a.textContent || '').trim().replace(/\s+/g, ' ').replace(/↗/g, '').trim();
      let desc = '';
      if (card) {
        const h = card.querySelector('h3, h2');
        if (h) title = h.textContent?.trim() || title;
        const par = card.querySelector('p');
        if (par) desc = par.textContent?.trim() || '';
      }
      if (!desc) desc = 'Opens ' + a.href + ' in a new tab.';
      return { title: title || a.href, desc };
    }

    function applyImage(src: string) {
      if (!lpImg || !lpNote) return;
      lpImg.onload = () => {
        const isPortrait = lpImg.naturalHeight > lpImg.naturalWidth;
        lpImg.classList.toggle('object-contain', isPortrait);
        lpImg.classList.toggle('bg-[#0e0b18]', isPortrait);
        lpImg.classList.toggle('object-cover', !isPortrait);
        lpImg.classList.toggle('object-top', !isPortrait);
      };
      lpImg.src = src;
      lpImg.hidden = false;
      lpNote.hidden = true;
    }

    function showPreview(a: HTMLAnchorElement) {
      if (!fine || !lp || !lpImg || !lpFallback || !lpHost || !lpTitle || !lpDesc || !lpNote) return;
      activeLink = a;
      const info = describeLink(a);
      const host = a.hostname || a.href;
      lpHost.textContent = host;
      lpTitle.textContent = info.title;
      lpDesc.textContent = info.desc;
      lpFallback.textContent = host.replace(/^www\./, '');
      lpNote.hidden = true;
      lpImg.hidden = true;
      lpImg.removeAttribute('src');

      const { localSrc, mshotSrc } = getPreviewSources(a);
      const cachedMshot = mshotSrc ? previewCache.get(mshotSrc) : undefined;

      if (cachedMshot?.status === 'ok' && mshotSrc) {
        applyImage(mshotSrc);
      } else {
        if (localSrc) {
          loadPreview(localSrc, (ok) => {
            if (activeLink !== a || !ok) return;
            const latestMshot = mshotSrc ? previewCache.get(mshotSrc) : undefined;
            if (latestMshot?.status === 'ok') return;
            applyImage(localSrc);
          });
        }

        if (mshotSrc) {
          loadPreview(mshotSrc, (ok) => {
            if (activeLink !== a) return;
            if (ok) {
              applyImage(mshotSrc);
            } else if (!localSrc) {
              lpNote.hidden = false;
            }
          });
        } else if (!localSrc) {
          lpNote.hidden = false;
        }
      }

      const r = a.getBoundingClientRect();
      const w = 300, h = 288;
      const x = Math.min(Math.max(12, r.left + r.width / 2 - w / 2), window.innerWidth - w - 12);
      let y = r.top - h - 12;
      if (y < 12) y = r.bottom + 12;

      lp.style.left = `${x}px`;
      lp.style.top = `${y}px`;
      lp.classList.add('show');
      lp.setAttribute('aria-hidden', 'false');
    }

    function hidePreview() {
      activeLink = null;
      if (!lp) return;
      lp.classList.remove('show');
      lp.setAttribute('aria-hidden', 'true');
    }

    const links = Array.from(document.querySelectorAll('a[target="_blank"]')) as HTMLAnchorElement[];
    links.forEach((a) => {
      if (a.dataset.lpBound) return;
      a.dataset.lpBound = '1';
      a.addEventListener('mouseenter', () => showPreview(a));
      a.addEventListener('mouseleave', hidePreview);
      a.addEventListener('focus', () => showPreview(a));
      a.addEventListener('blur', hidePreview);
    });

    if (fine && links.length > 0) {
      schedulePrefetch(links);
    }

    window.addEventListener('scroll', hidePreview, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLinkPreview);
  } else {
    initLinkPreview();
  }
  document.addEventListener('astro:page-load', initLinkPreview);
</script>

